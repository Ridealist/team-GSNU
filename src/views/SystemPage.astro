---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import type { Locale } from "../i18n/config";

interface Props { locale: Locale }
const { locale } = Astro.props;
const base = import.meta.env.BASE_URL;
const demoAccountName = "테스트";

const content = {
  ko: {
    title: "시스템 · TBLT-Agent",
    description: "TBLT-Agent 영어 회화 실습 시스템 접속 방법과 KERIS 에듀집 등록 정보를 안내합니다.",
    introHeading: "영어 과업을 위한<br />실시간 음성 AI 파트너.",
    introBody: "TBLT-Agent는 과업 기반 언어교수법을 적용한 영어 회화 실습 시스템입니다. 아래 테스트 계정으로 학습자 경험을 확인할 수 있습니다.",
    openSystem: "시스템 접속하기",
    accessHeading: "접속 방법",
    steps: [
      { title: "학습자 시스템 열기", body: "아래 주소를 열어 TBLT-Agent 로그인 화면으로 이동합니다." },
      { title: "테스트 계정 입력", body: "학생용 테스트 계정 정보를 각 입력란에 입력합니다." },
      { title: "영어 과업 시작", body: "안내에 따라 마이크 사용을 허용하고 실시간 음성 과업을 시작합니다." },
    ],
    studentId: "학번",
    studentName: "이름",
    browserNote: "원활한 이용을 위해 마이크가 연결된 Chrome 기반 브라우저를 권장합니다.",
    adminHeading: "관리자 포털",
    adminBody: "기존 시스템 주소 뒤에 <code>/admin/</code>을 붙인 관리자 전용 URL로 접속한 뒤 아래 테스트 계정을 입력합니다.",
    securityTitle: "보안 안내",
    securityBody: "실제 수업에서 활용중인 시스템입니다. 설정을 변경하지 마시고 실제 운영 상황을 확인하기 위한 용도로만 활용해주세요.",
    edzipHeading: "에듀집 등록 현황",
    registrationStatus: "등록 완료",
    edzipDate: "2026.07.07 · KERIS 안내",
    edzipTitle: "과업 기반 언어교수법 적용<br />영어 회화 실습 시스템",
    edzipBody: "학습지원 소프트웨어 필수기준 체크리스트와 관련 증빙자료의 에듀집 등록이 완료되었습니다.",
    edzipLink: "에듀집에서 확인하기",
    proofLinkLabel: "에듀집 필수기준 점검결과 화면 원본 보기",
    proofAlt: "에듀집 필수기준 점검결과에서 과업 기반 언어교수법 적용 영어 회화 실습 시스템이 확인완료 상태로 등록된 화면",
    proofCaption: "에듀집 필수기준 점검결과 등록 화면",
    edzipNote: "※ ‘등록 완료’는 KERIS 안내 메일에 따른 체크리스트 및 증빙자료의 에듀집 게시 상태를 의미합니다.",
  },
  en: {
    title: "System · TBLT-Agent",
    description: "Access the TBLT-Agent English conversation practice system and view its KERIS Edzip registration information.",
    introHeading: "A real-time voice AI partner<br />for English tasks.",
    introBody: "TBLT-Agent is an English conversation practice system grounded in task-based language teaching. Use the test account below to experience the system as a learner.",
    openSystem: "Open the system",
    accessHeading: "How to access",
    steps: [
      { title: "Open the learner system", body: "Follow the link below to open the TBLT-Agent login screen." },
      { title: "Enter the test account", body: "Enter the student test account details in the corresponding fields." },
      { title: "Start the English task", body: "Allow microphone access when prompted, then begin the real-time voice task." },
    ],
    studentId: "Student ID",
    studentName: "Name",
    browserNote: "For the best experience, use a Chromium-based browser with a connected microphone.",
    adminHeading: "Administrator portal",
    adminBody: "Open the administrator-only URL by adding <code>/admin/</code> to the system address, then enter the test account below.",
    securityTitle: "Security notice",
    securityBody: "This system is used in active classes. Do not change any settings; use the portal only to review the current operational environment.",
    edzipHeading: "Edzip registration",
    registrationStatus: "Registration complete",
    edzipDate: "July 7, 2026 · KERIS notice",
    edzipTitle: "English Conversation Practice System<br />Based on Task-Based Language Teaching",
    edzipBody: "The required standards checklist and supporting documentation for learning-support software have been registered with Edzip.",
    edzipLink: "View on Edzip",
    proofLinkLabel: "View the original Edzip standards review screen",
    proofAlt: "Edzip standards review screen showing the English conversation practice system based on task-based language teaching with a verified status",
    proofCaption: "Edzip required standards review registration screen",
    edzipNote: "※ ‘Registration complete’ refers to the publication status of the checklist and supporting documents on Edzip, as described in the KERIS notice.",
  },
} as const;

const copy = content[locale];
---

<BaseLayout locale={locale} title={copy.title} description={copy.description} overlayHeader>
  <PageHero title="System" />

  <div class="system-content section-shell">
    <header class="system-intro">
      <p class="section-index">TBLT-AGENT PLATFORM</p>
      <div>
        <h2 set:html={copy.introHeading} /><p>{copy.introBody}</p>
        <a class="system-primary-link" href="https://tblt-agent.net/" target="_blank" rel="noopener noreferrer">{copy.openSystem} <span aria-hidden="true">↗</span></a>
      </div>
    </header>

    <section class="access-section" aria-labelledby="access-heading">
      <div class="system-section-heading"><span>01</span><div><p>GET STARTED</p><h2 id="access-heading">{copy.accessHeading}</h2></div></div>
      <ol class="access-steps">
        <li><span class="access-step-number">STEP 01</span><h3>{copy.steps[0].title}</h3><p>{copy.steps[0].body}</p><a href="https://tblt-agent.net/" target="_blank" rel="noopener noreferrer">tblt-agent.net <span aria-hidden="true">↗</span></a></li>
        <li>
          <span class="access-step-number">STEP 02</span><h3>{copy.steps[1].title}</h3><p>{copy.steps[1].body}</p>
          <dl class="demo-credentials"><div><dt>{copy.studentId}</dt><dd>99999</dd></div><div><dt>{copy.studentName}</dt><dd>{demoAccountName}</dd></div><div><dt>Access code</dt><dd>aa00</dd></div></dl>
        </li>
        <li><span class="access-step-number">STEP 03</span><h3>{copy.steps[2].title}</h3><p>{copy.steps[2].body}</p><small>{copy.browserNote}</small></li>
      </ol>
    </section>

    <section class="admin-section" aria-labelledby="admin-heading">
      <div>
        <p class="section-index">ADMINISTRATOR</p><h2 id="admin-heading">{copy.adminHeading}</h2><p set:html={copy.adminBody} />
        <dl class="admin-credentials"><div><dt>ID</dt><dd> ----- </dd></div><div><dt>Password</dt><dd> ----- </dd></div></dl>
        <p class="credential-warning"><strong>{copy.securityTitle}</strong> {copy.securityBody}</p>
      </div>
      <a href="https://tblt-agent.net/admin/" target="_blank" rel="noopener noreferrer">Admin portal <span aria-hidden="true">↗</span></a>
    </section>

    <section class="edzip-section" aria-labelledby="edzip-heading">
      <div class="system-section-heading"><span>02</span><div><p>KERIS · EDZIP</p><h2 id="edzip-heading">{copy.edzipHeading}</h2></div></div>
      <div class="edzip-card">
        <div class="edzip-card__status"><span aria-hidden="true">✓</span><div><small>REGISTRATION STATUS</small><strong>{copy.registrationStatus}</strong></div></div>
        <div class="edzip-card__content"><p class="edzip-date">{copy.edzipDate}</p><h3 set:html={copy.edzipTitle} /><p>{copy.edzipBody}</p><a href="https://edzip.kr/utilization/learning-sw/6a4c8430a8c837d1d3e536f4" target="_blank" rel="noopener noreferrer">{copy.edzipLink} <span aria-hidden="true">↗</span></a></div>
      </div>
      <figure class="edzip-proof">
        <a href={`${base}assets/images/system/edzip-registration.png`} target="_blank" aria-label={copy.proofLinkLabel}><img src={`${base}assets/images/system/edzip-registration.png`} alt={copy.proofAlt} width="1602" height="1586" loading="lazy" /></a>
        <figcaption><span>KERIS EDZIP · 2026.07.07</span> {copy.proofCaption}</figcaption>
      </figure>
      <p class="edzip-note">{copy.edzipNote}</p>
    </section>
  </div>
</BaseLayout>
