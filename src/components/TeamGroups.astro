---
import { initials, members, type Member } from "../data/members";
import { teamGroups } from "../data/teamGroups";

const base = import.meta.env.BASE_URL;

// Members in both groups close the SLA list and open the NLP list.
const inGroup = (id: keyof typeof teamGroups) =>
  members
    .filter((member) => !member.lead && member.groups.includes(id))
    .sort((a, b) => (id === "sla" ? 1 : -1) * (a.groups.length - b.groups.length));

const sections = [
  { id: "faculty", title: "Faculty", people: members.filter((member) => member.lead) },
  ...[teamGroups.sla, teamGroups.nlp].map((group) => ({
    id: group.id,
    title: group.label,
    people: inGroup(group.id),
  })),
];

const links = (member: Member) => [
  member.profileUrl && { href: member.profileUrl, label: member.profileLabel ?? "Homepage", icon: "profile" },
  member.scholarUrl && { href: member.scholarUrl, label: "Google Scholar", icon: "scholar" },
].filter((link): link is { href: string; label: string; icon: string } => Boolean(link));
---

<div class="rp-team">
  {sections.map((section) => (
    <section class="rp-team__section" aria-labelledby={`team-${section.id}`}>
      <h3 id={`team-${section.id}`}>{section.title}</h3>
      <ul class:list={["rp-team__people", { "rp-team__people--faculty": section.id === "faculty" }]}>
        {section.people.map((member) => (
          <li>
            {member.image
              ? <img src={`${base}assets/images/members/${member.image}`} alt="" width="136" height="136" loading="lazy" />
              : <span class="rp-avatar" aria-hidden="true">{initials(member)}</span>}
            <strong>{member.displayName}</strong>
            <span>{member.position}<br />{member.department && <>{member.department}<br /></>}{member.organization}</span>
            {links(member).length > 0 && (
              <div class="rp-team__links">
                {links(member).map((link) => (
                  <a href={link.href} target="_blank" rel="noopener noreferrer" aria-label={`${member.displayName} · ${link.label}`} title={link.label}>
                    {link.icon === "scholar"
                      ? <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 1 9l11 6 9-4.9V17h2V9L12 3Zm-7 9.2V16c0 1.7 3.1 3 7 3s7-1.3 7-3v-3.8l-7 3.8-7-3.8Z" /></svg>
                      : <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4h16a1 1 0 0 1 1 1v14a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V5a1 1 0 0 1 1-1Zm1 2v12h14V6H5Zm2 2h5v5H7V8Zm7 0h3v1.5h-3V8Zm0 3h3v1.5h-3V11Zm-7 4h10v1.5H7V15Z" /></svg>}
                  </a>
                ))}
              </div>
            )}
          </li>
        ))}
      </ul>
    </section>
  ))}
</div>
